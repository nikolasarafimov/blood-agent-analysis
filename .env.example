MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest

MINIO_ROOT_USER=bloodagent
MINIO_ROOT_PASSWORD=replace-with-a-strong-unique-password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_SECURE=false
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9090

API_PORT=8000
UI_PORT=3000

MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
MODEL_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

ENABLE_LLM_OCR=false
ALLOW_UNREDACTED_LLM_OCR=false
ENABLE_LLM_ANONYMIZATION=false

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false

MAX_UPLOAD_MB=20
MAX_UPLOAD_FILES=5
MAX_PROMPT_CHARS=10000
MAX_DOCUMENT_PAGES=30
MAX_OCR_IMAGE_PIXELS=40000000
MAX_STORAGE_READ_MB=32
OCR_TIMEOUT_SECONDS=60
PDF_RENDER_TIMEOUT_SECONDS=60
OCRMYPDF_TIMEOUT_SECONDS=300

REACT_APP_API_URL=http://localhost:8000
REACT_APP_OCR_LANGUAGE=mkd+eng
REACT_APP_PERSIST_SESSIONS=false